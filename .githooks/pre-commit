#!/usr/bin/env bash
# .githooks/pre-commit
#
# Auto-bumpar `updated:`-fält i YAML-frontmatter på staged styrande
# docs till dagens datum. Idempotent. Hanterar GNU + BSD sed.
#
# Config: .frontmatter-policy.conf (repo-root). Hooket failar säkert
# (exit 0, ingen ändring) om config saknas — hookens uppgift är inte
# att verifiera konfig (det är check-frontmatter.sh:s jobb i CI).
#
# Aktiveras via: git config core.hooksPath .githooks
# (sätts i K7.C postinstall-script i package.json)
#
# Bypass: git commit --no-verify (git inbyggt)
#
# Källa: docs/decisions/ADR-030-docs-grindvakter-frontmatter-policy.md
# Etablerad: Session 6.6 K7 (2026-05-14)

set -euo pipefail

# === Ladda projekt-config ===
CONFIG_FILE=".frontmatter-policy.conf"
if [[ ! -f "${CONFIG_FILE}" ]]; then
    # Tyst skip — hooket ska inte blockera commits om config saknas.
    # CI-validator fångar config-saknad explicit.
    exit 0
fi
# shellcheck source=/dev/null
source "${CONFIG_FILE}"

# Verifiera att config har nödvändig variabel — om inte, tyst skip
if [[ -z "${FRONTMATTER_GOVERNING_DOCS:-}" ]]; then
    exit 0
fi

GOVERNING_DOCS=("${FRONTMATTER_GOVERNING_DOCS[@]}")
TODAY="$(date +%F)"
BUMPED_FILES=()

# GNU vs BSD sed-detection (single-shot)
if sed --version >/dev/null 2>&1; then
    SED_INPLACE=(-i)
else
    SED_INPLACE=(-i "")
fi

# Iterera staged filer (added, copied, modified — INTE deleted/renamed)
# UTF-8-safe iteration via -z + NUL-terminated read.
# Källa: Git officiell docs https://git-scm.com/docs/diff-options
# Trigger: K0.1 (Session 6.6.6) v3.md systematic auto-bump-miss
# pga core.quotepath=true default + exakt-match-fail på escape.
# Klass-pattern: K1.17 (tj-actions UTF-8-glob, samma fil-domän,
# annan tooling) + denna instans = 2 bekräftade. Hub-konsolidering
# vid Session 6.6.6 K-sista-0.
#
# Implementation: temp-fil-pattern över process-substitution per
# L_C nivå 1 + Session 6.6.7 K3.1 SC2312-precedent. Bevarar
# set -euo pipefail-semantik (git-fail exiterar scriptet);
# process-substitution `< <(...)` skulle maska git:s exit-status
# (SC2312 info under shellcheck --enable=all).

STAGED_NUL=$(mktemp)
trap 'rm -f "${STAGED_NUL}"' EXIT
git diff --cached --name-only --diff-filter=ACM -z > "${STAGED_NUL}"

while IFS= read -r -d '' staged; do
    # Matcha mot governing-listan (exakt path)
    is_governing=0
    for gov in "${GOVERNING_DOCS[@]}"; do
        if [[ "${staged}" = "${gov}" ]]; then is_governing=1; break; fi
    done
    [[ "${is_governing}" -eq 0 ]] && continue

    # Verifiera att fil har frontmatter med updated:
    if ! head -10 "${staged}" | grep -qE "^updated:"; then
        # Ingen updated-rad — hooket bumpar inte filer utan
        # frontmatter (K7.C ansvarar för bulk-add)
        continue
    fi

    # Idempotent: skip om värdet redan är today
    if head -10 "${staged}" | grep -qE "^updated: ${TODAY}$"; then
        continue
    fi

    # In-place bump (sed-variant per plattform)
    sed "${SED_INPLACE[@]}" -E "s/^updated: [0-9]{4}-[0-9]{2}-[0-9]{2}$/updated: ${TODAY}/" "${staged}"

    # Re-staga bumpad fil
    git add "${staged}"

    BUMPED_FILES+=("${staged}")
done < "${STAGED_NUL}"

# Rapport till stdout (K11.5 11/10-felmeddelande-design)
if [[ "${#BUMPED_FILES[@]}" -gt 0 ]]; then
    echo "pre-commit: auto-bumpade 'updated' → ${TODAY} på styrande docs:"
    for f in "${BUMPED_FILES[@]}"; do
        echo "  - ${f}"
    done
fi

exit 0

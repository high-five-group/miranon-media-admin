#!/usr/bin/env bash
# .githooks/pre-commit
#
# Auto-bumpar `updated:`-fält i YAML-frontmatter på staged styrande
# docs till dagens datum. Idempotent. Hanterar GNU + BSD sed.
#
# Config: .frontmatter-policy.conf (repo-root). Hooket failar säkert
# (exit 0, ingen ändring) om config saknas — hookens uppgift är inte
# att verifiera konfig (det är check-frontmatter.sh:s jobb i CI).
#
# Aktiveras via: git config core.hooksPath .githooks
# (sätts i K7.C postinstall-script i package.json)
#
# Bypass: git commit --no-verify (git inbyggt)
#
# Källa: docs/decisions/ADR-030-docs-grindvakter-frontmatter-policy.md
# Etablerad: Session 6.6 K7 (2026-05-14)

set -euo pipefail

# === Vakt: core.hooksPath måste vara RELATIV (T121, 2026-08-04) ===
#
# En ABSOLUT hooksPath pekar ALLA worktrees mot huvudkatalogens hook-kopia.
# Två följder, båda mätta samma dag tråden registrerades:
#   1. En agent som ändrar DENNA fil i sin worktree testar aldrig sin egen
#      version — `git commit` där kör huvudkatalogens kopia.
#   2. Varje landad hook-ändring byter hook i alla levande worktrees i samma
#      ögonblick, mitt i deras pass.
#
# `package.json`:s postinstall sätter värdet RELATIVT och har gjort så sedan
# 2026-05-14 — ändå stod det absolut vid mätningen 2026-08-04. Någon skrev
# över det för hand, och eftersom postinstall bara kör vid `npm install` var
# driften osynlig i månader. Det är skälet till att en engångsrättelse inte
# räcker och att denna vakt finns.
#
# VARNAR, fäller inte: fel hooksPath är ett miljöfel, inte ett kodfel, och att
# blockera en commit på det vore att straffa fel sak. Att denna hook alls kör
# bevisar att NÅGON hook nås — varningen når därför alltid sin läsare.
HOOKS_PATH="$(git config --get core.hooksPath 2>/dev/null || true)"
if [[ -n "${HOOKS_PATH}" && "${HOOKS_PATH}" = /* ]]; then
    printf 'VARNING (T121): core.hooksPath är ABSOLUT (%s).\n' "${HOOKS_PATH}" >&2
    printf '  Varje worktree kör då huvudkatalogens hook, inte sin egen.\n' >&2
    printf '  Rätta med:  git config core.hooksPath .githooks\n' >&2
fi

# === Ladda projekt-config ===
CONFIG_FILE=".frontmatter-policy.conf"
if [[ ! -f "${CONFIG_FILE}" ]]; then
    # Tyst skip — hooket ska inte blockera commits om config saknas.
    # CI-validator fångar config-saknad explicit.
    exit 0
fi
# shellcheck source=/dev/null
source "${CONFIG_FILE}"

# Verifiera att config har nödvändig variabel — om inte, tyst skip
if [[ -z "${FRONTMATTER_GOVERNING_DOCS:-}" ]]; then
    exit 0
fi

GOVERNING_DOCS=("${FRONTMATTER_GOVERNING_DOCS[@]}")
TODAY="$(date +%F)"
BUMPED_FILES=()

# GNU vs BSD sed-detection (single-shot)
if sed --version >/dev/null 2>&1; then
    SED_INPLACE=(-i)
else
    SED_INPLACE=(-i "")
fi

# Iterera staged filer (added, copied, modified — INTE deleted/renamed)
# UTF-8-safe iteration via -z + NUL-terminated read.
# Källa: Git officiell docs https://git-scm.com/docs/diff-options
# Trigger: K0.1 (Session 6.6.6) v3.md systematic auto-bump-miss
# pga core.quotepath=true default + exakt-match-fail på escape.
# Klass-pattern: K1.17 (tj-actions UTF-8-glob, samma fil-domän,
# annan tooling) + denna instans = 2 bekräftade. Hub-konsolidering
# vid Session 6.6.6 K-sista-0.
#
# Implementation: temp-fil-pattern över process-substitution per
# L_C nivå 1 + Session 6.6.7 K3.1 SC2312-precedent. Bevarar
# set -euo pipefail-semantik (git-fail exiterar scriptet);
# process-substitution `< <(...)` skulle maska git:s exit-status
# (SC2312 info under shellcheck --enable=all).

STAGED_NUL=$(mktemp)
trap 'rm -f "${STAGED_NUL}"' EXIT
git diff --cached --name-only --diff-filter=ACM -z > "${STAGED_NUL}"

while IFS= read -r -d '' staged; do
    # Matcha mot governing-listan (exakt path)
    is_governing=0
    for gov in "${GOVERNING_DOCS[@]}"; do
        if [[ "${staged}" = "${gov}" ]]; then is_governing=1; break; fi
    done
    [[ "${is_governing}" -eq 0 ]] && continue

    # Verifiera att fil har frontmatter med updated:
    if ! head -10 "${staged}" | grep -qE "^updated:"; then
        # Ingen updated-rad — hooket bumpar inte filer utan
        # frontmatter (K7.C ansvarar för bulk-add)
        continue
    fi

    # Idempotent: skip om värdet redan är today
    if head -10 "${staged}" | grep -qE "^updated: ${TODAY}$"; then
        continue
    fi

    # In-place bump (sed-variant per plattform)
    sed "${SED_INPLACE[@]}" -E "s/^updated: [0-9]{4}-[0-9]{2}-[0-9]{2}$/updated: ${TODAY}/" "${staged}"

    # Re-staga bumpad fil
    git add "${staged}"

    BUMPED_FILES+=("${staged}")
done < "${STAGED_NUL}"

# Rapport till stdout (K11.5 11/10-felmeddelande-design)
if [[ "${#BUMPED_FILES[@]}" -gt 0 ]]; then
    echo "pre-commit: auto-bumpade 'updated' → ${TODAY} på styrande docs:"
    for f in "${BUMPED_FILES[@]}"; do
        echo "  - ${f}"
    done
fi

# === Staging-preflightens wiring (T119 (d) item 4) ===
#
# scripts/check-staging-preflight-wiring.mjs (TASK-91) fällde TASK-131
# (PR #651, CI-run 30814438519) och TASK-126.4 (merge 9747a52f) — två
# äkta, deterministiska fynd (ett oklassat Playwright-projekt vardera).
# Vakten kör i dag bara i CI (ci.yml:965), EFTER push och kö-inträde —
# kostnaden att rätta är som störst just där. Samma anrop körs här också,
# FÖRE commit, så felet fångas billigast.
#
# ANROPET ÄR OFÖRÄNDRAT — ingen egen retry-logik i denna hook. Bounded
# retry kring G0-transienten (TASK-115) bor i skriptet självt och gäller
# identiskt oavsett anropare. Transienten är dessutom CI-parallellism-
# specifik: TASK-115s egen forensik körde hela sviten lokalt mot det exakta
# felande trädet och fick exit 0 varje gång — inte en risk att bygga extra
# maskineri emot här.
#
# VILLKORAD, INTE OVILLKORLIG — Marcus krav är att mekaniseringen ökar
# produktiviteten, inte sinkar den. Vakten kör bara när en staged ändring
# rör den yta den faktiskt sveper (config i
# .staging-preflight-hook-policy.conf) — mätt ≈1,2–1,7 s lokalt (macOS,
# 2026-08-04) när den KÖR, men de allra flesta commits (src/, docs/ osv.)
# rör aldrig den ytan och betalar noll.
#
# EXIT-KODEN AVGÖR — vakten är fail-closed med tre koder (0/1/64):
#   0  wiring intakt                         → tyst, fortsätt.
#   1  wiring TRASIG (deterministiskt fynd)  → STOPPA commiten.
#   64 vakten kunde inte svara (policy-/miljöfel, ELLER en transient som
#      inte löstes av skriptets egna tre försök) → VARNA, stoppa INTE.
#      Detta är den medvetna spärren mot en falsk lokal röd: 64 betyder
#      "kunde inte avgöra", inte "trasig wiring" — och CI kör samma vakt
#      som sista linje om något ändå slank igenom.
STAGING_WIRING_CONFIG=".staging-preflight-hook-policy.conf"
if [[ -f "${STAGING_WIRING_CONFIG}" ]]; then
    STAGING_WIRING_TRIGGER_PATHS=()
    # shellcheck source=/dev/null
    source "${STAGING_WIRING_CONFIG}"

    if [[ "${#STAGING_WIRING_TRIGGER_PATHS[@]}" -gt 0 ]]; then
        STAGING_WIRING_NUL=$(mktemp)
        trap 'rm -f "${STAGED_NUL}" "${STAGING_WIRING_NUL}"' EXIT

        # Inget --diff-filter: vakten TASK-91 grindar är uttryckligen en
        # DELETIONS-vakt, så en borttagen setup-fil måste synas här precis
        # som en tillagd eller ändrad.
        git diff --cached --name-only -z > "${STAGING_WIRING_NUL}"

        STAGING_WIRING_TRAFFAD=0
        while IFS= read -r -d '' staged; do
            for prefix in "${STAGING_WIRING_TRIGGER_PATHS[@]}"; do
                if [[ "${prefix}" == */ ]]; then
                    [[ "${staged}" == "${prefix}"* ]] || continue
                else
                    [[ "${staged}" = "${prefix}" ]] || continue
                fi
                STAGING_WIRING_TRAFFAD=1
                break 2
            done
        done < "${STAGING_WIRING_NUL}"

        if [[ "${STAGING_WIRING_TRAFFAD}" -eq 1 ]]; then
            echo "pre-commit: staged ändring rör staging-preflightens wiring-yta — kör scripts/check-staging-preflight-wiring.mjs..."

            if node scripts/check-staging-preflight-wiring.mjs; then
                STAGING_WIRING_EXIT=0
            else
                STAGING_WIRING_EXIT=$?
            fi

            if [[ "${STAGING_WIRING_EXIT}" -eq 1 ]]; then
                echo ""
                echo "pre-commit: STOPPAD — staging-preflightens wiring är bruten (exit 1, se ovan)."
                echo "  Samma vakt som fällde TASK-131 (#651) och TASK-126.4 — ett äkta fynd,"
                echo "  inte en flaka. Rätta wiringen eller klassa den nya ytan i"
                echo "  .staging-preflight-wiring-policy.json. Bypass (endast om du VET att"
                echo "  detta är fel): git commit --no-verify."
                exit 1
            elif [[ "${STAGING_WIRING_EXIT}" -ne 0 ]]; then
                echo "pre-commit: vakten kunde inte svara (exit ${STAGING_WIRING_EXIT}) — troligen en miljöfråga (npm ci ej kört) eller en olöst G0-transient. Commiten fortsätter ändå; CI kör samma vakt som sista linje."
            fi
        fi
    fi
fi

exit 0

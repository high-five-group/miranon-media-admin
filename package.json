{
  "name": "miranon-media-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:api": "playwright test --project=api-pure --project=api-staging",
    "test:api:pure": "playwright test --project=api-pure",
    "test:api:staging": "playwright test --project=api-staging"
  },
  "dependencies": {
    "@react-aria/focus": "^3.21.5",
    "@react-aria/overlays": "^3.31.2",
    "@react-aria/utils": "^3.33.1",
    "@react-stately/collections": "^3.12.10",
    "@sentry/react": "^10.48.0",
    "@supabase/supabase-js": "^2.105.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "1.168.19",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "1.167.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "nuqs": "^2.8.9",
    "react": "^19.2.6",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.2.6",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "audit-ci": "^7.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "overrides": {
    "@tanstack/history": "1.161.6"
  },
  "description": "React-admin för Miranon Media — eventhantering, anmälningar och rapportering ovanpå Airtable + Supabase. Privat projekt.",
  "author": "Marcus Johansson <marcus@h5gruppen.se>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcus803/miranon-media-admin.git"
  },
  "homepage": "https://github.com/marcus803/miranon-media-admin#readme",
  "keywords": [
    "miranon",
    "react",
    "react-19",
    "airtable",
    "supabase",
    "vite",
    "tanstack",
    "tailwind-v4",
    "biome",
    "admin"
  ],
  "engines": {
    "node": ">=20"
  }
}

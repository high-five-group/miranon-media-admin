{
  "name": "miranon-media-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "build:staging": "npm run build -- --mode staging",
    "preview": "vite preview",
    "preview:staging": "vite preview --port 4173 --strictPort",
    "verify:staging-bundle": "bash scripts/check-staging-bundle.sh",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check .",
    "lint:prose": "vale docs tasks README.md CHANGELOG.md SECURITY.md CONTRIBUTING.md ORDLISTA.md",
    "format": "biome format --write .",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:api": "PLAYWRIGHT_NO_WEB_SERVER=1 playwright test --project=api-pure --project=api-staging",
    "test:api:pure": "PLAYWRIGHT_NO_WEB_SERVER=1 playwright test --project=api-pure",
    "test:api:staging": "PLAYWRIGHT_NO_WEB_SERVER=1 playwright test --project=api-staging",
    "test:e2e:staging": "playwright test --project=chromium-authenticated",
    "test:preview:staging": "npm run build:staging && npm run verify:staging-bundle && PLAYWRIGHT_STAGING_PREVIEW=1 playwright test --project=staging-preview",
    "test:a11y": "PLAYWRIGHT_A11Y_DEV_SERVER=1 playwright test --project=a11y",
    "purge:staging": "node --env-file-if-exists=.env.seed scripts/purge-staging-sentinels.mjs",
    "metrics:ci": "node scripts/ci-metrics.mjs",
    "postinstall": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/overlays": "^3.32.1",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/collections": "^3.13.1",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.110.6",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "1.168.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "nuqs": "^2.9.0",
    "react": "^19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-cli": "1.167.19",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "audit-ci": "^7.1.0",
    "axe-core": "~4.12.1",
    "markdownlint-cli2": "^0.23.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "@tanstack/history": "1.161.6",
    "linkify-it": "6.0.0",
    "sharp": "0.35.3"
  },
  "description": "React-admin för Miranon Media — eventhantering, anmälningar och rapportering ovanpå Airtable + Supabase. Privat projekt.",
  "author": "Marcus Johansson <marcus@h5gruppen.se>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcus803/miranon-media-admin.git"
  },
  "homepage": "https://github.com/marcus803/miranon-media-admin#readme",
  "keywords": [
    "miranon",
    "react",
    "react-19",
    "airtable",
    "supabase",
    "vite",
    "tanstack",
    "tailwind-v4",
    "biome",
    "admin"
  ],
  "engines": {
    "node": ">=24"
  }
}

# Klient-side env-variabler (VITE_*-prefix exponeras i bundle).
# Kopiera till .env.local och fyll i värden för lokal utveckling.
# .env.local är gitignored (matchas av *.local).

# Supabase URL — t.ex. https://<projekt>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon-key (publik per definition — exponeras i bundle).
VITE_SUPABASE_ANON_KEY=

# Sentry DSN för klient-side error tracking. Optional — om saknad
# initieras inte Sentry (t.ex. lokal dev). Sätt i staging/prod
# samt i .env.local om du vill testa Sentry-flödet lokalt.
# Klient-DSN är publik per design (Gate A1 alternativ A).
VITE_SENTRY_DSN=

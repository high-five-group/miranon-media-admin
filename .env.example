# Klient-side env-variabler (VITE_*-prefix exponeras i bundle).
#
# MILJÖ-KONVENTION (ADR-061 Pelare 1 — Vite mode-separation):
# Miljö-pekaren (Supabase-URL + anon-key) bor i COMMITTADE mode-filer, INTE här
# och INTE i .env.local. Vite väljer fil per mode automatiskt:
#   .env.development  → dev (`npm run dev`)        → STAGING (interim, ADR-061 Väg B; lokal-stack = T31)
#   .env.staging      → `vite build --mode staging` → STAGING (ADR-050 isolerad staging)
#   .env.production   → `vite build` (prod-mode)    → PROD
# Dessa filer bär ENDAST publika VITE_-vars (URL + anon/publishable-key, RLS-grindade)
# och är säkra att committa per ADR-061 / Supabase. Hemligheter (Airtable-PAT m.m.)
# bor i Edge-Function-env, ALDRIG i en VITE_-variabel.
#
# .env.local (gitignored, matchas av *.local + .env.*) är till för MILJÖ-AGNOSTISKA
# maskin-overrides ONLY — aldrig miljö-pekaren. Lämna den tom om du inte har en.
# Tester: TEST_*-vars (creds + staging-ref) bor i .env.test (gitignored, ej committad).

# --- Referensformat för mode-filernas innehåll ---

# Supabase URL — t.ex. https://<projekt>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon-key (publik per definition — exponeras i bundle, RLS-grindad).
VITE_SUPABASE_ANON_KEY=

# Sentry DSN för klient-side error tracking. Optional — om saknad initieras inte
# Sentry (t.ex. lokal dev). Klient-DSN är publik per design (Gate A1 alternativ A).
# Miljö-agnostisk → kan ligga i .env.local för lokalt Sentry-test.
VITE_SENTRY_DSN=

# [TASK-346.4 AC #6] Betalningsflödets miljöflagga. Tre lägen: `pa`, `av`,
# eller FRÅNVARANDE (= av). Satt till `pa` i .env.development och
# .env.staging; medvetet FRÅNVARANDE i .env.production tills Marcus slår på
# den efter prod-migrationerna (PRD TASK-346 användarberättelse 36).
# Ett annat värde än `pa`/`av` kraschar uppstarten med avsikt — ett stavfel
# ska aldrig tyst tolkas som avstängt. Rivs av TASK-346.12; hela rivningens
# omfattning står i src/lib/funktionsflaggor.ts.
VITE_FEATURE_BETALNINGAR=

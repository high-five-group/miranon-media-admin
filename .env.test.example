# Env-variabler för Playwright API-tester (tests/api/).
# Kopiera till .env.test och fyll i värden för staging-projektet.
# .env.test är gitignored (matchar *.local? — verifiera, annars lägg till).

# Staging-projektets URL — t.ex. https://abcdefgh.supabase.co
TEST_SUPABASE_URL=

# Anon-key för staging — publik per definition, OK att ha lokalt
TEST_SUPABASE_ANON_KEY=

# Test-user (non-admin) för "giltig user-JWT → 200"-tester och
# "user utan admin-email → 403"-tester (M6).
# Skapas via Supabase dashboard eller `supabase auth admin create-user`.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Test-admin-user (på ADMIN_EMAILS-listan i staging-secret) för
# "admin-email → 200"-tester (M6 create-admin-user).
# Måste finnas i ADMIN_EMAILS-secret (komma-separerad lista) i
# staging-projektet, annars returnerar create-admin-user 403.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

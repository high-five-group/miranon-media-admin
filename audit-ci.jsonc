  // $schema ger IDE-completion. Källa: https://github.com/IBM/audit-ci
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",

  // Fail vid high+critical (matchar pre-K2 `npm audit --audit-level=high`-beteende).
  // Moderate/low rapporteras men failar inte CI.
  "high": true,

  // Allowlist-historik: GHSA-rmmr-r34h-pfm5 togs bort (K0åh, 2026-05-13) efter att
  // GitHub Security Advisory uppdaterade vulnerable_version_range från ">=0" till
  // "= 1.161.9" + "= 1.161.12" 2026-05-12 — vår installerade @tanstack/history@1.161.6
  // är pre-malware och inte längre i vulnerable range. audit-ci varnade explicit
  // "Consider not allowlisting advisory: GHSA-rmmr-r34h-pfm5". Se ADR-028 ## Updates.
  // Vid framtida incident-respons: fyll på allowlist + dokumentera per ADR-028
  // 5-stegs Konvention-flöde.
  //
  // GHSA-gv7w-rqvm-qjhr (esbuild >= 0.17.0 < 0.28.1, high, publicerad 2026-06-12):
  // "Missing binary integrity verification in Deno module enables RCE via
  // NPM_CONFIG_REGISTRY". Allowlistad 2026-06-13 per ADR-028 Konvention-flöde,
  // Marcus-beslut alternativ C (Session 17 STOPPA-svar; beslutstrail
  // tasks/sessions/2026-06-13-session-17.md). RIVEN 2026-07-19 (S70
  // dependabot-passet): sluttillståndet nått STARKARE än riv-villkoret
  // "esbuild >= 0.28.1" — esbuild är HELT ute ur trädet (`npm ls esbuild`
  // tomt; vite 8-erans deps-bumpar drog beroendet). Verifierat: npm audit
  // 0 träffar på advisoryn; audit-ci:s egen varning "Consider not
  // allowlisting" observerad sedan S68. Session 17-riv-todon bockad i
  // tasks/todo.md i samma commit.
  "allowlist": []
}

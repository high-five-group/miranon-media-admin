// .markdownlint-cli2.jsonc — markdownlint-cli2 config för Miranon Media Admin.
// Per ADR-030 § Del 1.1. Etablerad: Session 6.6 K4 2026-05-14.
//
// Kör i CI docs-jobb (conditional på docs_changed) efter Lychee.
// Ingen pre-commit-hook (markdownlint är CI-only-grindvakt — pre-commit
// reserveras för biome + K7-frontmatter).
//
// Disables under "config" är ALDRIG slapphet — varje disable är aktivt
// motiverat val baserat på empirisk baseline 2026-05-14 (10 570 fynd) +
// branschpraxis-research mot Vite/Next.js/Astro docs-konfigurationer.
{
  "config": {
    // MD013 — line-length: disable.
    // Svensk prosa har långa sammansatta ord ("verifikations-disciplin",
    // "implementations-mönsterförstärkning") och 80-tecken-konventionen
    // är engelsk-kod-tradition utan motsvarighet i svenskt skrivande.
    // Branschpraxis (Vite, Next.js, Astro docs) disabelar MD013 i markdown.
    // K2-precedent (yamllint line-length disable) följer samma logik.
    "MD013": false,

    // MD060 — table-column-style: disable.
    // Repo använder kompakt tabell-stil |kol| (utan space-padding)
    // konsekvent över ~250 tabeller. Auto-fix till paddad-stil |  kol  |
    // skulle ändra 100 % av tabellerna utan kvalitetsvinst. Aktivt
    // konvention-val per kompakt-läsbarhet, inte slapphet.
    "MD060": false,

    // MD024 — no-duplicate-heading: siblings_only.
    // Keep-a-Changelog-konvention har ### Added / ### Changed / ### Security
    // under varje ## [X.Y.Z]-release-rubrik. siblings_only tillåter samma
    // rubrik under olika parent-hierarki men flaggar duplicering inom
    // samma parent (vilket är legitim hygien-check).
    "MD024": {
      "siblings_only": true
    }
  },

  // backlog/ medvetet utanför globs — verktygsägd yta (L226; S48 Del 2 gren C)
  // tasks/lessons.d/ = nummerlösa lesson-fragment (ADR-081). Måste lintas HÄR,
  // eftersom ett olintat fragment annars bär in sina fel i lessons.md vid
  // konsolideringen — då fälls grinden på en fil ingen just rörde.
  //
  // tasks/lessons/*.md TILLAGT TASK-161.9 (2026-08-08, ADR-085-volymformen).
  // "tasks/*.md" korsar INTE kataloggränsen till en underkatalog (standard
  // glob-semantik) — utan denna egna post blir volymfilerna tyst olintade,
  // exakt den täcknings-lucka lessons.d-raden ovan redan varnar för i sitt
  // eget fall.
  //
  // .claude/**/*.md tillagd S91 (TASK-71). Agentdefinitionerna är prosa som
  // styr agenternas arbete och låg tidigare utanför SAMTLIGA docs-grindar.
  // Posten hör ihop med .claude/**-raderna i ci.yml:s BÅDA changed-files-listor:
  // klassningen gör filerna testsvit-skippade, och då måste någon grind faktiskt
  // läsa dem — annars är de tyst ovaliderade (L322-klassen).
  // Egen post krävs: ingen av globbarna ovan når katalogen, och ett blott '**'
  // hade inte heller gjort det — dot-yta matchas inte utan dot: true.
  // MD041 är scope-lokalt omkonfigurerad i .claude/.markdownlint.jsonc — inte
  // avstängd; se den filen för varför.
  "globs": [
    "docs/**/*.md",
    "tasks/*.md",
    "tasks/sessions/*.md",
    "tasks/threads/*.md",
    "tasks/lessons.d/*.md",
    "tasks/lessons/*.md",
    ".claude/**/*.md",
    "./*.md"
  ],

  "ignores": [
    "tasks/sessions/archive/**",
    "docs/archive/**",
    "docs/reference/pocock/**",
    // .claude/worktrees/ = Claude Code:s agent-worktrees, alltså KOMPLETTA
    // checkouts av repot på andra grenar. De är gitignorerade, men
    // markdownlint-cli2 läser inte .gitignore — mätt 2026-07-28: utan denna
    // rad drar .claude/**/*.md in varje .md-fil i varje aktiv worktree, och
    // grinden faller då på en annan grens innehåll. Samma klass som
    // node_modules/**- och dist/**-raderna nedan: gitignorerad yta som ändå
    // måste räknas upp för hand.
    ".claude/worktrees/**",
    // Rå-transkript, vendoriserat 2026-07-25 (S87). Endast KÄLLFILEN exkluderas
    // — destillatet i samma katalog är vår egen prosa och grindas normalt.
    // Snävare än pocock-precedenten med avsikt: exkludera råmaterial, inte hyllan.
    "docs/reference/miranon-arkitektur/miranon-arkitektur-konversation-*.md",
    "tests/vale-regression/**",
    "node_modules/**",
    "dist/**",
    "coverage/**"
  ]
}

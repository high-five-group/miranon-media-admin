{
  "extraKnownMarketplaces": {
    "marcus-hub": {
      "source": {
        "source": "github",
        "repo": "marcus803/marcus-system"
      }
    }
  },
  "enabledPlugins": {
    "marcus-system@marcus-hub": true
  },
  "permissions": {
    "allow": [
      "Bash(git pull)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(npm run test:api)",
      "Bash(npm run test:api:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx @biomejs/biome check:*)",
      "Bash(npx playwright test:*)",
      "Bash(backlog task:*)",
      "Bash(backlog sequence:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(vale:*)"
    ]
  }
}

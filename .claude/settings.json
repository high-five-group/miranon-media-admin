{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if ((.tool_input.command // \"\") | test(\"(^|[;&|]\\\\s*|\\\\$\\\\()gh +run +watch\")) and ((.tool_input.run_in_background // false) | not) then {hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"CI-vakt i förgrunden är förbjuden (S76-praxis): kör gh run watch som bakgrundstask (run_in_background: true) med fil-skriven exit-kod (L309), och fortsätt icke-push-arbetet under vakttiden.\"}} else empty end'",
            "timeout": 10,
            "statusMessage": "CI-vakt-grinden (S76)"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent-spawn-log.sh\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Agent-spawn-mätning (effektiv isolering)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/deny-resend-send.sh\"",
            "timeout": 10,
            "statusMessage": "MAIL-LÅSET — Resend-sänd-endpoints (TASK-137, Rogers krav)"
          }
        ]
      },
      {
        "matcher": "^mcp__resend__send-(email|batch-emails|broadcast|event)$|^mcp__plugin_resend_resend__send-(email|batch-emails|broadcast|event)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/deny-resend-send.sh\"",
            "timeout": 10,
            "statusMessage": "MAIL-LÅSET — Resend-sänd-MCP-verktyg, dubbel botten (TASK-137, Rogers krav)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/deny-frammande-huvudkatalog.sh\"",
            "timeout": 10,
            "statusMessage": "KATALOGÄGARSKAP — git-skriv i främmande huvudkatalog (ADR-090 beslut 2)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/deny-grind-genom-pipe.sh\"",
            "timeout": 10,
            "statusMessage": "L440 — grindens exitkod genom en pipe"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/stop-vakt.sh\"",
            "timeout": 10,
            "statusMessage": "Stop-vakten (T108/ADR-087)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/stop-vakt.sh\"",
            "timeout": 10,
            "statusMessage": "Stop-vakten (T108/ADR-087)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/katalogagarskap-markor.sh\"",
            "timeout": 10,
            "statusMessage": "Katalogägarskaps-lappen (ADR-090 beslut 2)"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "extraKnownMarketplaces": {
    "marcus-hub": {
      "source": {
        "source": "github",
        "repo": "high-five-group/marcus-system"
      }
    }
  },
  "enabledPlugins": {
    "marcus-system@marcus-hub": true
  },
  "permissions": {
    "deny": [
      "mcp__resend__send-email",
      "mcp__resend__send-batch-emails",
      "mcp__resend__send-broadcast",
      "mcp__resend__send-event",
      "mcp__plugin_resend_resend__send-email",
      "mcp__plugin_resend_resend__send-batch-emails",
      "mcp__plugin_resend_resend__send-broadcast",
      "mcp__plugin_resend_resend__send-event"
    ],
    "allow": [
      "Bash(git pull)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(npm run test:api)",
      "Bash(npm run test:api:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx @biomejs/biome check:*)",
      "Bash(npx playwright test:*)",
      "Bash(backlog task:*)",
      "Bash(backlog sequence:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(vale:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(git worktree:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git rm:*)",
      "Bash(npm ci)",
      "Bash(npm install @tanstack/react-query-persist-client:*)",
      "Bash(npm install @tanstack/query-sync-storage-persister:*)",
      "Bash(npm run test:a11y)",
      "Bash(cp /Users/marcus/Repon/miranon-media-admin/.env.local:*)",
      "Bash(cp /Users/marcus/Repon/miranon-media-admin/.env.test:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(rmdir:*)",
      "Bash(rm:*)",
      "Bash(bash scripts/staging-semaphore.sh:*)",
      "Bash(npm install dotenv:*)",
      "Bash(npm run build:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run dev:*)",
      "Bash(kill:*)"
    ]
  }
}
